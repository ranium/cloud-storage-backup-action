{
  "provider": "aws",
  "region": "ap-south-1",
  "bucket": "example-offsite-backups",
  "stack_name": "offsite-backups",
  "github_repository": "example-org/cloud-backups",
  "github_branch": "main",
  "create_github_oidc_provider": true,
  "retention": {
    "daily_days": 35,
    "monthly_days": 365,
    "noncurrent_file_version_days": 90,
    "dump_version_recovery_days": 7
  }
}
